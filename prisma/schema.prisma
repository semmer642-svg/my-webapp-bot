generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model Player {
  id          String   @id @default(cuid())
  telegramId  String   @unique
  username    String?
  displayName String
  coin        Int      @default(5000)
  xp          Int      @default(0)
  level       Int      @default(1)
  attack      Int      @default(10)
  defense     Int      @default(10)
  health      Int      @default(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  matches     Match[]  @relation("PlayerMatches")
}
model Match {
  id          String   @id @default(cuid())
  playerId    String
  player      Player   @relation("PlayerMatches", fields: [playerId], references: [id])
  opponentType String
  status      String   @default("pending")
  stake       Int      @default(0)
  winner      String?
  log         Json?
  createdAt   DateTime @default(now())
}
